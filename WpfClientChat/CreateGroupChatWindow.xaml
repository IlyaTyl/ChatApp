<Window x:Class="WpfClientChat.CreateGroupChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfClientChat"
        mc:Ignorable="d"
        Title="Создание группового чата" Height="400" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="10" VerticalAlignment="Stretch">

        <TextBlock Text="Название группы:" FontWeight="Bold" />
        <TextBox x:Name="groupNameTextBox" Margin="0,5,0,10"/>

        <TextBlock Text="Выберите друзей:" FontWeight="Bold" />
        <ScrollViewer Height="200">
            <ItemsControl x:Name="friendsListBox">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding UserName}" IsChecked="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Content="Создать" Margin="0,10,0,0" Click="CreateButton_Click" HorizontalAlignment="Center" Width="100"/>
    </StackPanel>
</Window>
