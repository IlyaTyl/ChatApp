<Window x:Class="WpfClientChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfClientChat"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="300" Closing="Window_Closing">
    <StackPanel Margin="4">
        <ListBox x:Name="chatbox" Height="360" />
        <TextBox x:Name="messageTextBox" />
        <Button x:Name="sendBtn" Content="Отправить" Click="Button_Click" IsEnabled="False" />
    </StackPanel>
</Window>
