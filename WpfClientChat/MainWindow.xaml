<Window x:Class="WpfClientChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfClientChat"
        xmlns:shared="clr-namespace:SignalRAppChat.Shared.Models;assembly=SignalRAppChat.Shared"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="400" Closing="Window_Closing" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150px"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBox x:Name="searchTextBox" TextChanged="searchTextBox_TextChanged" />
            <ListBox x:Name="searchResultsListBox" SelectionChanged="searchResultsListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding UserName}"/>
                            <Button Content="+" Click="АddPrivateChat_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="privateChatsListBox" DisplayMemberPath="UserName" SelectionChanged="privateChatsListBox_SelectionChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <ListBox x:Name="chatbox" Height="360" Loaded="chatbox_Loaded" ScrollViewer.ScrollChanged="chatbox_ScrollChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type shared:Message}">
                        <TextBlock>
                        <Run Text="{Binding SentAt, StringFormat='{}{0:HH:mm}'}"/>
                        <Run Text=" " />
                        <Run Text="{Binding UserName}" FontWeight="Bold" />
                        <Run Text=": " />
                        <Run Text="{Binding Text}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBox x:Name="messageTextBox" />
            <Button x:Name="sendBtn" Content="Отправить" Click="Button_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
